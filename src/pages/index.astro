---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout
  title="PizzaCalc | Calculadora de Masa de Pizza & Fermentación Mixta"
  description="Calcula los ingredientes exactos para tu masa de pizza napolitana, romana o casera según tiempo a temperatura ambiente y nevera."
>
  <main class="home-landing-container">
    <!-- Hero Section -->
    <section class="home-hero-section">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="lucide:sparkles" class="hero-badge-icon" />
          <span data-i18n="homeHeroBadge">Calculadora de Masa PWA 100% Offline</span>
        </div>

        <h1 class="hero-title" data-i18n="homeHeroTitle">
          Calcula la Masa de Pizza Perfecta
        </h1>

        <p class="hero-subtitle" data-i18n="homeHeroSubtitle">
          Porcentajes de panadero profesionales y algoritmo cinético de fermentación mixta (Temperatura Ambiente + Nevera). Diseñada para pizzaiolos caseros y apasionados.
        </p>

        <div class="hero-actions">
          <a href="/calculator" class="btn-hero-primary">
            <Icon name="lucide:calculator" class="btn-icon-svg" />
            <span data-i18n="homeCtaBtn">Abrir Calculadora</span>
          </a>
          <a href="/faq" class="btn-hero-secondary">
            <Icon name="lucide:book-open" class="btn-icon-svg" />
            <span data-i18n="navFaq">Guía de Fermentación</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Key Features Section -->
    <section class="home-features-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="homeFeaturesTitle">Todo lo que Necesitas para Amasar</h2>
        <p class="section-subtitle" data-i18n="homeFeaturesSubtitle">Herramientas precisas para conseguir bordes alveolados, masas digeribles y resultados de pizzería.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <Icon name="lucide:scale" />
          </div>
          <h3 data-i18n="homeFeature1Title">Porcentaje de Panadero</h3>
          <p data-i18n="homeFeature1Desc">Cálculo exacto de harina (100%), hidratación, sal y levadura según las proporciones clásicas de la panadería profesional.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <Icon name="lucide:snowflake" />
          </div>
          <h3 data-i18n="homeFeature2Title">Fermentación Mixta</h3>
          <p data-i18n="homeFeature2Desc">Algoritmo cinético que simula la fermentación combinando horas en nevera (TC) y leudado a temperatura ambiente (TA).</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <Icon name="lucide:zap" />
          </div>
          <h3 data-i18n="homeFeature3Title">Modos Simple y Avanzado</h3>
          <p data-i18n="homeFeature3Desc">Modo rápido con ajustes predeterminados napolitanos o control absoluto de peso de bola, hidratación y sal.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <Icon name="lucide:wifi-off" />
          </div>
          <h3 data-i18n="homeFeature4Title">100% Offline (PWA)</h3>
          <p data-i18n="homeFeature4Desc">Funciona sin cobertura en cualquier cocina u horno de leña. Añádela a la pantalla de inicio de tu móvil como app nativa.</p>
        </div>
      </div>
    </section>

    <!-- Pizza Styles Preview Section -->
    <section class="home-styles-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="homeStylesTitle">Estilos de Pizza Soportados</h2>
      </div>

      <div class="styles-preview-grid">
        <div class="style-preview-card">
          <div class="style-card-header">
            <Icon name="lucide:flame" class="style-card-icon" />
            <div>
              <h3>Pizza Napolitana</h3>
              <span class="style-tag">Tradicional</span>
            </div>
          </div>
          <p>Bola de 280g • 65% Hidratación • 2.5% Sal. Bordes altos, suaves, ligeros y digestión perfecta con maduración lenta.</p>
        </div>

        <div class="style-preview-card">
          <div class="style-card-header">
            <Icon name="lucide:wheat" class="style-card-icon" />
            <div>
              <h3>Tonda Romana</h3>
              <span class="style-tag">Crujiente</span>
            </div>
          </div>
          <p>Bola de 180g • 57% Hidratación • 2.5% Sal. Fina, crujiente (scrocchiarella) y con tostado característico.</p>
        </div>
      </div>
    </section>

    <!-- Bottom Launch Banner -->
    <section class="home-cta-banner">
      <div class="cta-banner-content">
        <Icon name="lucide:pizza" class="cta-banner-icon" />
        <h2 data-i18n="homeCtaTitle">¿Listo para amasar tu próxima pizza?</h2>
        <p data-i18n="homeCtaSubtitle">Obtén la receta con las cantidades exactas de ingredientes en segundos.</p>
        <a href="/calculator" class="btn-hero-primary">
          <Icon name="lucide:calculator" class="btn-icon-svg" />
          <span data-i18n="homeCtaBtn">Ir a la Calculadora</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../app.ts';
</script>
